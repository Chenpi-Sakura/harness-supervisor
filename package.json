{
  "name": "harness-supervisor",
  "version": "0.12.3",
  "description": "A small lifecycle and messaging layer for native AI agent harnesses (Pi first).",
  "type": "module",
  "license": "MIT",
  "homepage": "https://gitcode.com/chenpi_1/harness-supervisor",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Chenpi-Sakura/harness-supervisor.git"
  },
  "bin": {
    "harness-supervisor": "dist/src/cli.js",
    "harness-sup": "dist/src/cli.js",
    "harness-sup-mcp": "dist/src/mcp.js"
  },
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src",
    "dist/web",
    "README.md"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "build": "tsc -p tsconfig.json && npm run build:web",
    "build:web": "vite build --config web/vite.config.ts",
    "build:plugin": "npm --prefix packages/dsh-plugin run build",
    "test:plugin": "npm --prefix packages/dsh-plugin test",
    "test:web": "node --import tsx --test web/test/*.test.mjs",
    "pack:core": "node scripts/pack-core.mjs",
    "test": "npm run build && node test/run.mjs",
    "test:unit": "npm run build && node test/run.mjs unit",
    "test:integration": "npm run build && node test/run.mjs integration",
    "test:e2e": "npm run build && node test/run.mjs e2e",
    "e2e:parent": "npm run build && node scripts/e2e-parent-pi.mjs",
    "e2e:persistent:pi": "npm run build && node scripts/e2e-persistent-pi.mjs --runtime pi",
    "e2e:persistent:qoder": "npm run build && node scripts/e2e-persistent-pi.mjs --runtime qoder",
    "e2e:persistent:mcode": "npm run build && node scripts/e2e-persistent-pi.mjs --runtime mcode",
    "e2e:persistent:dsh": "npm run build && node scripts/e2e-persistent-pi.mjs --runtime dsh",
    "e2e:codex": "npm run build && node scripts/e2e-codex.mjs",
    "e2e:mcode": "npm run build && node scripts/e2e-mcode.mjs",
    "e2e:mcode:long": "npm run build && node scripts/e2e-mcode-long-turn.mjs",
    "e2e:mcode:final": "npm run build && node scripts/e2e-mcode-final-message.mjs",
    "e2e:mcode:steer": "npm run build && node scripts/e2e-mcode-steer.mjs",
    "cli": "node dist/src/cli.js",
    "mcp": "node dist/src/mcp.js",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json",
    "e2e:qoder:acp": "npm run build && node scripts/e2e-qoder-acp.mjs",
    "e2e:mcp:runtimes": "npm run build && node scripts/e2e-mcp-runtimes.mjs",
    "e2e:dsh:acp": "npm run build && node scripts/e2e-dsh-acp.mjs",
    "e2e:codex:wake": "npm run build && node scripts/e2e-codex-wake.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "lucide-react": "^1.72.0",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^8.3.7"
  }
}
